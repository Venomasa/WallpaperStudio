{
  "name": "wallpaper-studio",
  "productName": "Wallpaper Studio",
  "version": "0.3.5",
  "description": "Modern desktop wallpaper manager for Windows — manage local collections and discover photos from Unsplash",
  "author": "Venomasa",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/inject-env.js",
    "build": "electron-builder --win",
    "prebuild:portable": "node scripts/inject-env.js",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.wallpaperstudio.app",
    "productName": "Wallpaper Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Wallpaper Studio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "wallpaper": "^3.0.0",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.13.3"
  }
}
